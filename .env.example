# Copy to .env for local runs; chuck reads it at startup. A variable left
# empty is the same as unset. What each does, and its default, is in the
# cmd/chuck/main.go doc comment.

# Paths and timing. Leave empty for the defaults.
CHUCK_CONFIG_DIR=
CHUCK_DB_PATH=
CHUCK_HEARTBEAT=
PORT=

# GitHub webhooks: the dev App's secret (phase-1-human-steps.md 1.5).
GITHUB_APP_WEBHOOK_SECRET=
# 1 accepts deliveries from any IP. Set it for a local run behind a tunnel,
# whose requests come from the tunnel, not GitHub. Never in production.
CHUCK_WEBHOOK_ALLOW_ANY_IP=

# Workers. Set one launcher and the URL workers reach chuck on; without a
# launcher every launch fails on its transition row. For a laptop:
# CHUCK_WORKER_LOCAL_BIN=path/to/chuck-worker and
# CHUCK_PUBLIC_URL=http://localhost:8080. A repo's validate credentials go
# in LOOP_ENV_<OWNER>_<REPO> as dotenv lines.
CHUCK_PUBLIC_URL=
FLY_WORKERS_API_TOKEN=
CHUCK_WORKER_REGION=
CHUCK_WORKER_LOCAL_BIN=
