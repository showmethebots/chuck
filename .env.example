# Copy to .env for local runs; chuck reads it at startup. A variable left
# empty is the same as unset. What each does, and its default, is in the
# cmd/chuck/main.go doc comment.

# Paths and timing. Leave empty for the defaults.
CHUCK_CONFIG_DIR=
CHUCK_DB_PATH=
CHUCK_HEARTBEAT=
PORT=

# GitHub webhooks: the dev App's secret (phase-1-human-steps.md 1.5).
GITHUB_APP_WEBHOOK_SECRET=

# Haiku triage.
ANTHROPIC_API_KEY=

# Slack: all four or none (phase-1-human-steps.md 3.7).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
CHUCK_SLACK_MAIN_CHANNEL=
CHUCK_SLACK_SHADOW_CHANNEL=

# Daily jobs. Leave empty for the defaults.
CHUCK_DAILY_AT=
CHUCK_GRADE_SAMPLE=
