{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "criteria_ids", "sub_issues", "supersedes", "questions"],
  "properties": {
    "outcome": { "enum": ["ready_for_approval", "needs_clarification"] },
    "summary": { "type": "string", "maxLength": 2000 },
    "criteria_ids": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
    "sub_issues": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "test"],
        "properties": {
          "criterion": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "test": { "type": "string", "pattern": "^#[0-9]+ AC-[0-9]+$" }
        }
      }
    },
    "questions": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
  }
}
