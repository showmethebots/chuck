{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "reviewed_sha", "comment_url", "findings_count", "skills_not_run"],
  "properties": {
    "outcome": { "enum": ["posted", "failed"] },
    "summary": { "type": "string", "maxLength": 2000 },
    "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "comment_url": { "type": "string", "maxLength": 500, "pattern": "^(https://[^\\s]+)?$" },
    "findings_count": { "type": "integer", "minimum": 0 },
    "skills_not_run": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
  }
}
